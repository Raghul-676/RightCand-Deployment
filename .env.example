# ==============================================================================
# RightCand & SCES - Environment Configuration Template
# Copy this file to '.env' for local runs, or set these in Render Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine (Required)
# ------------------------------------------------------------------------------
# Get your free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. GitHub API Client (Optional, Recommended)
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained) to increase rate limit
# from 60 req/hr to 5,000 req/hr when analyzing repositories
GITHUB_TOKEN=ghp_your_github_token_here

# ------------------------------------------------------------------------------
# 3. Security & Authentication (Optional)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens in Talent Vellocity
SECRET_KEY=rightcand-super-secret-jwt-key-change-in-production

# ------------------------------------------------------------------------------
# 4. Networking & Ports (Optional)
# ------------------------------------------------------------------------------
# Server port (Render sets this dynamically via $PORT)
PORT=8000

# Allowed CORS origins (comma-separated, or '*' for open access)
ALLOWED_ORIGINS=*

# Custom SQLite database location (leave unset to use default Talent Vellocity/sces/backend/sces.db)
# DATABASE_URL=sqlite:///./sces.db
